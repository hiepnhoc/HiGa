---
import { render } from 'astro:content';
import Share from '../../layouts/Share.astro';
import { allPosts, fmtDate, plain, splitId } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await allPosts()).filter((p) => p.data.share);
  return posts.map((post) => ({ params: { slug: splitId(post.id).slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<Share title={post.data.title} description={post.data.tldr}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <span>{fmtDate(post.data.date)}</span>
      {post.data.updated && <span>· cập nhật {fmtDate(post.data.updated)}</span>}
      {post.data.tags.length > 0 && (
        <span class="chips">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</span>
      )}
      {post.data.source && <a href={post.data.source} target="_blank" rel="noopener">nguồn ↗</a>}
    </div>
    {post.data.tldr && <div class="tldr"><b>TL;DR</b><br />{plain(post.data.tldr)}</div>}
    {toc.length > 2 && (
      <details class="small muted" style="margin-bottom:18px">
        <summary>Mục lục</summary>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </details>
    )}
    <div class="prose"><Content /></div>
  </article>
</Share>
